<?xml version="1.0" ?>
<!--
Author: Pradheep Padmanabhan
Contributor: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rox">
<!-- This is the main URDF file for rox robot -->

  <!-- Xacro Arguments-->
  <xacro:arg name="use_gz" default="false"/>
  <xacro:arg name="use_imu" default="false"/>
  <xacro:arg name="use_d435" default="false"/>
  <xacro:arg name="scanner_type" default="nanoscan"/>
  <xacro:arg name="rox_type" default="argo"/>
  <xacro:arg name="joint_type" default="fixed"/>
  <xacro:arg name="enable_linear_axis" default="false"/>

  <!-- Manipulator Arguments-->
  <xacro:arg name="arm_type" default=""/>
  <xacro:arg name="arm_parent" default="cabinet_link"/>
  <xacro:arg name="arm1_prefix" default="arm1_"/>
  <xacro:arg name="arm2_type" default=""/>
  <xacro:arg name="arm2_parent" default="cabinet_link"/>
  <xacro:arg name="arm2_prefix" default="arm2_"/>
  <xacro:arg name="gripper_type" default=""/>
  <xacro:arg name="use_ur_dc" default="false"/>
  <xacro:arg name="force_abs_paths" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="linear_axis_simulation_controllers" default=""/>
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />

  <xacro:arg name="include_arm_ros2_control" default="false"/>
  <xacro:arg name="include_gripper_ros2_control" default="false"/>

  <!-- UR arm parameters (shared) -->
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="initial_positions_file" default="$(find rox_bringup)/configs/ur/initial_joint_positions.yaml"/>

  <!-- Xacro Properties -->
  <xacro:property name="gz" value="$(arg use_gz)"/>
  <xacro:property name="imu" value="$(arg use_imu)"/>
  <xacro:property name="d435" value="$(arg use_d435)"/>
  <xacro:property name="scanner" value="$(arg scanner_type)"/>
  <xacro:property name="rox_typ" value="$(arg rox_type)"/>
  <xacro:property name="joint_typ" value="$(arg joint_type)"/>
  <xacro:property name="arm" value="$(arg arm_type)"/>
  <xacro:property name="arm2" value="$(arg arm2_type)"/>
  <xacro:property name="ur_dc" value="$(arg use_ur_dc)"/>
  <xacro:property name="gripper" value="$(arg gripper_type)"/>
  <xacro:property name="use_mock" value="$(arg use_mock_hardware)"/>
  <xacro:property name="linear_axis" value="$(arg enable_linear_axis)"/>

  <!-- Include xacro files -->
  <xacro:include filename="$(find rox_description)/urdf/xacros/frame.xacro" />
  
  <!-- Nanoscan -->
  <xacro:include filename="$(find rox_description)/urdf/xacros/sick_nanoscan.xacro" />

  <!-- PSenScan -->
  <xacro:include filename="$(find rox_description)/urdf/xacros/pilz_psenscan.xacro" />

  <!-- Building the robot from here -->
  <link name="base_link" />

  <xacro:rox_base 
    name="base_footprint"  
    parent="base_link"
    >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:rox_base>

  <!-- Argo drives -->
  <xacro:if value="${rox_typ == 'argo'}">
    <xacro:include filename="$(find rox_description)/urdf/xacros/argo_drive.xacro" />
    <xacro:argo_drive parent="base_link"/>
  </xacro:if>
  <xacro:if value="${rox_typ == 'argo-trio'}">
      <xacro:include filename="$(find rox_description)/urdf/xacros/argo_trio_drive.xacro" />
      <xacro:argo_trio_drive parent="base_footprint"/>
  </xacro:if>
  
  <!-- Diff drive -->
  <!-- Includes both Trike and Diff -->
  <xacro:if value="${rox_typ == 'diff'}">
    <xacro:include filename="$(find rox_description)/urdf/xacros/diff_drive.xacro" />
    <xacro:property name="wheel_separation" value="0.634" />
    <xacro:diff_drive parent="base_link" wheel_separation="${wheel_separation}"/>
  </xacro:if>

  <!-- Trike drive -->
  <xacro:if value="${rox_typ == 'trike'}">
    <xacro:include filename="$(find rox_description)/urdf/xacros/trike_drive.xacro" />
    <xacro:property name="wheel_separation" value="0.5955" />
    <xacro:trike_drive parent="base_link" wheel_separation="${wheel_separation}"/>
  </xacro:if>

  <!-- Linear axis (EMROX-Argo variant) -->
  <xacro:if value="${linear_axis == True}">
    <xacro:include filename="$(find rox_description)/urdf/xacros/linear_axis.xacro"/>
    <xacro:linear_axis parent="base_link"/>
  </xacro:if>

  <!-- Scanner placement -->
  <!-- Linear-axis variant is wider in X (wheel centers +0.05m per side), Y unchanged. -->
  <xacro:if value="${linear_axis == True}">
    <xacro:property name="nanoscan_x" value="0.3495"/>
    <xacro:property name="nanoscan_y" value="0.2690"/>
    <xacro:property name="psenscan_x" value="0.3516"/>
    <xacro:property name="psenscan_y" value="0.2719"/>
  </xacro:if>
  <xacro:unless value="${linear_axis == True}">
    <xacro:property name="nanoscan_x" value="0.2995"/>
    <xacro:property name="nanoscan_y" value="0.2690"/>
    <xacro:property name="psenscan_x" value="0.3016"/>
    <xacro:property name="psenscan_y" value="0.2719"/>
  </xacro:unless>

  <!-- Laser scanners -->

  <!-- Nanoscans -->
  <xacro:if value="${scanner == 'nanoscan'}">
    <xacro:sick_nanoscan name="lidar_1" parent="base_link">
      <origin rpy="${pi} 0 ${pi/4}" xyz="${nanoscan_x} ${nanoscan_y} 0.189"/>
    </xacro:sick_nanoscan>

    <xacro:sick_nanoscan name="lidar_2" parent="base_link">
      <origin rpy="${pi} 0 -${pi - pi/4}" xyz="-${nanoscan_x} -${nanoscan_y} 0.189"/>
    </xacro:sick_nanoscan>
  </xacro:if>
  
  <!-- Pilz -->
  <xacro:if value="${scanner == 'psenscan'}">
    <xacro:pilz_psenscan name="lidar_1" parent="base_link">
      <origin rpy="0 0 ${pi/4}" xyz="${psenscan_x} ${psenscan_y} 0.191"/>
    </xacro:pilz_psenscan>

    <xacro:pilz_psenscan name="lidar_2" parent="base_link">
      <origin rpy="0 0 -${pi - pi/4}" xyz="-${psenscan_x} -${psenscan_y} 0.191"/>
    </xacro:pilz_psenscan>
  </xacro:if>

  <!-- IMU -->
  <xacro:if value="${imu == True}">
    <link name="imu_link">
      <inertial>
        <mass value="0.001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia 
          ixx="0.0001" 
          ixy="0" 
          ixz="0" 
          iyy="0.000001" 
          iyz="0" 
          izz="0.0001"
          />
      </inertial>  
    </link>
    <joint name="imu_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <origin rpy="0 0 0" xyz="-0.052 0.208 0.266"/>
      <parent link="base_link"/>
      <child link="imu_link"/>
    </joint>
  </xacro:if>

  <!-- Realsense D435 -->
  <xacro:if value="${d435 == True}">
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
    <!-- use_nominal_extrinsics is True for simulation-->
    <xacro:sensor_d435 parent="base_link" name="d435_camera" use_nominal_extrinsics="true">
      <origin xyz="0.375 0.0 0.220" rpy="0 0 0"/>
    </xacro:sensor_d435>
  </xacro:if>

  <!-- Arms -->
  <xacro:unless value="${arm == '' and arm2 == ''}">

    <!-- Include cabinet (only when linear axis is NOT enabled — linear_axis.xacro defines its own cabinet_link) -->
    <xacro:unless value="${linear_axis == True}">
      <xacro:include filename="$(find rox_description)/urdf/xacros/cabinet.xacro" />
      <xacro:cabinet name="cabinet" parent="base_footprint">
        <origin rpy="0 0 0" xyz="0 0 0.33"/>
      </xacro:cabinet>
    </xacro:unless>

    <!-- ============================================================ -->
    <!-- ARM 1 (prefix: arm1_)                                        -->
    <!-- ============================================================ -->
    <xacro:unless value="${arm == ''}">

      <!-- Universal Robotics (UR) Arm 1 -->
      <xacro:if value="${arm == 'ur5' or arm == 'ur10' or arm == 'ur5e' or arm == 'ur10e'}">

        <!-- Different height for AC arm-->
        <xacro:if value="${ur_dc == False}">
          <xacro:property name="arm_height" value="0.376" />
        </xacro:if>

        <xacro:if value="${ur_dc == True}">
          <xacro:property name="arm_height" value="0.276" />
        </xacro:if>

        <!-- Include UR macros -->
        <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

        <!-- Arm 1 -->
        <xacro:if value="${linear_axis == True}">
          <xacro:ur_robot
            name="$(arg arm1_prefix)$(arg arm_type)"
            parent="linear_axis_slide_link"
            tf_prefix="$(arg arm1_prefix)"
            joint_limits_parameters_file="$(find ur_description)/config/$(arg arm_type)/joint_limits.yaml"
            kinematics_parameters_file="$(find ur_description)/config/$(arg arm_type)/default_kinematics.yaml"
            physical_parameters_file="$(find ur_description)/config/$(arg arm_type)/physical_parameters.yaml"
            visual_parameters_file="$(find ur_description)/config/$(arg arm_type)/visual_parameters.yaml"
            safety_limits="$(arg safety_limits)"
            safety_pos_margin="$(arg safety_pos_margin)"
            safety_k_position="$(arg safety_k_position)"
            force_abs_paths="$(arg force_abs_paths)"
            >
            <origin xyz="0.450 0.156 0.529" rpy="-${pi/3} 0 0" />
          </xacro:ur_robot>
        </xacro:if>
        <xacro:unless value="${linear_axis == True}">
          <xacro:ur_robot
            name="$(arg arm1_prefix)$(arg arm_type)"
            parent="$(arg arm_parent)"
            tf_prefix="$(arg arm1_prefix)"
            joint_limits_parameters_file="$(find ur_description)/config/$(arg arm_type)/joint_limits.yaml"
            kinematics_parameters_file="$(find ur_description)/config/$(arg arm_type)/default_kinematics.yaml"
            physical_parameters_file="$(find ur_description)/config/$(arg arm_type)/physical_parameters.yaml"
            visual_parameters_file="$(find ur_description)/config/$(arg arm_type)/visual_parameters.yaml"
            safety_limits="$(arg safety_limits)"
            safety_pos_margin="$(arg safety_pos_margin)"
            safety_k_position="$(arg safety_k_position)"
            force_abs_paths="$(arg force_abs_paths)"
            >
            <origin xyz="0.218 0.0 ${arm_height}" rpy="0.0 0.0 0.0" />
          </xacro:ur_robot>
        </xacro:unless>

      </xacro:if>

      <!-- Elite Arm 1 -->
      <xacro:if value="${arm == 'ec66' or arm == 'cs66'}">
        <xacro:property name="arm_height" value="0.376" />
        <xacro:include filename="$(find rox_description)/urdf/xacros/elite_arm.urdf.xacro"/>
      </xacro:if>

      <!-- Gripper on Arm 1 -->
      <xacro:unless value="${gripper == ''}">

        <xacro:if value="${gripper == '2f_140' or gripper == '2f_85'}">
          <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
          <xacro:ur_to_robotiq 
            prefix="$(arg arm1_prefix)" 
            parent="$(arg arm1_prefix)tool0"
            child="$(arg arm1_prefix)gripper_mount_link"
            rotation="${pi/2}"
            />

          <xacro:include filename="$(find robotiq_description)/urdf/robotiq_${gripper}_macro.urdf.xacro"/>
          <xacro:robotiq_gripper name="$(arg arm1_prefix)robotiq_gripper"
            prefix="$(arg arm1_prefix)"
            parent="$(arg arm1_prefix)gripper_mount_link"
            use_mock_hardware="${use_mock}"
            mock_sensor_commands="${use_mock}"
            sim_gazebo="${gz}"
            include_ros2_control="$(arg include_gripper_ros2_control)"
            >
            <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
          </xacro:robotiq_gripper>
        </xacro:if>

        <xacro:if value="${gripper == 'epick'}">
          <xacro:include filename="$(find epick_description)/urdf/epick_single_suction_cup.xacro"/>
          <xacro:epick_single_suction_cup parent="$(arg arm1_prefix)tool0"
            use_fake_hardware="${use_mock}"
            origin_xyz="0 0 0"
            origin_rpy="0 0 -${pi / 2}"
            />
        </xacro:if>

      </xacro:unless>

    </xacro:unless>

    <!-- ============================================================ -->
    <!-- ARM 2 (prefix: arm2_)                                        -->
    <!-- ============================================================ -->
    <xacro:unless value="${arm2 == ''}">

      <!-- Universal Robotics (UR) Arm 2 -->
      <xacro:if value="${arm2 == 'ur5' or arm2 == 'ur10' or arm2 == 'ur5e' or arm2 == 'ur10e'}">

        <!-- Different height for AC arm-->
        <xacro:if value="${ur_dc == False}">
          <xacro:property name="arm2_height" value="0.376" />
        </xacro:if>

        <xacro:if value="${ur_dc == True}">
          <xacro:property name="arm2_height" value="0.276" />
        </xacro:if>

        <!-- Arm 2 -->
        <xacro:if value="${linear_axis == True}">
          <xacro:ur_robot
            name="$(arg arm2_prefix)$(arg arm2_type)"
            parent="linear_axis_slide_link"
            tf_prefix="$(arg arm2_prefix)"
            joint_limits_parameters_file="$(find ur_description)/config/$(arg arm2_type)/joint_limits.yaml"
            kinematics_parameters_file="$(find ur_description)/config/$(arg arm2_type)/default_kinematics.yaml"
            physical_parameters_file="$(find ur_description)/config/$(arg arm2_type)/physical_parameters.yaml"
            visual_parameters_file="$(find ur_description)/config/$(arg arm2_type)/visual_parameters.yaml"
            safety_limits="$(arg safety_limits)"
            safety_pos_margin="$(arg safety_pos_margin)"
            safety_k_position="$(arg safety_k_position)"
            force_abs_paths="$(arg force_abs_paths)"
            >
            <origin xyz="0.450 -0.156 0.529" rpy="${pi/3} 0.0 0.0" />
          </xacro:ur_robot>
        </xacro:if>
        <xacro:unless value="${linear_axis == True}">
          <xacro:ur_robot
            name="$(arg arm2_prefix)$(arg arm2_type)"
            parent="$(arg arm2_parent)"
            tf_prefix="$(arg arm2_prefix)"
            joint_limits_parameters_file="$(find ur_description)/config/$(arg arm2_type)/joint_limits.yaml"
            kinematics_parameters_file="$(find ur_description)/config/$(arg arm2_type)/default_kinematics.yaml"
            physical_parameters_file="$(find ur_description)/config/$(arg arm2_type)/physical_parameters.yaml"
            visual_parameters_file="$(find ur_description)/config/$(arg arm2_type)/visual_parameters.yaml"
            safety_limits="$(arg safety_limits)"
            safety_pos_margin="$(arg safety_pos_margin)"
            safety_k_position="$(arg safety_k_position)"
            force_abs_paths="$(arg force_abs_paths)"
            >
            <origin xyz="-0.218 0.0 ${arm2_height}" rpy="0.0 0.0 0.0" />
          </xacro:ur_robot>
        </xacro:unless>

      </xacro:if>

      <!-- Gripper on Arm 2 -->
      <xacro:unless value="${gripper == ''}">

        <xacro:if value="${gripper == '2f_140' or gripper == '2f_85'}">
          <xacro:ur_to_robotiq 
            prefix="$(arg arm2_prefix)" 
            parent="$(arg arm2_prefix)tool0"
            child="$(arg arm2_prefix)gripper_mount_link"
            rotation="${pi/2}"
            />

          <xacro:robotiq_gripper name="$(arg arm2_prefix)robotiq_gripper"
            prefix="$(arg arm2_prefix)"
            parent="$(arg arm2_prefix)gripper_mount_link"
            use_mock_hardware="${use_mock}"
            mock_sensor_commands="${use_mock}"
            sim_gazebo="${gz}"
            include_ros2_control="$(arg include_gripper_ros2_control)"
            >
            <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
          </xacro:robotiq_gripper>
        </xacro:if>

        <xacro:if value="${gripper == 'epick'}">
          <xacro:epick_single_suction_cup parent="$(arg arm2_prefix)tool0"
            use_fake_hardware="${use_mock}"
            origin_xyz="0 0 0"
            origin_rpy="0 0 -${pi / 2}"
            />
        </xacro:if>

      </xacro:unless>

    </xacro:unless>

  </xacro:unless>

  <!-- Check if simulation needs to be used -->
  <xacro:if value="${gz == True}">
    <xacro:include filename="$(find rox_description)/urdf/xacros/gazebo.xacro" />
    <xacro:gazebo_plugins />

    <!-- Single consolidated gz_ros2_control plugin for ALL hardware (arms + linear axis) -->
    <xacro:unless value="${arm == '' and arm2 == '' and linear_axis == False}">
      <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system">
          <parameters>$(arg simulation_controllers)</parameters>
        </plugin>
      </gazebo>
    </xacro:unless>

    <!-- UR Arm ros2_control hardware interfaces -->
    <xacro:unless value="${arm == '' and arm2 == ''}">

      <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />

      <!-- Arm 1 ros2_control -->
      <xacro:unless value="${arm == ''}">
        <xacro:if value="${arm == 'ur5' or arm == 'ur10' or arm == 'ur5e' or arm == 'ur10e'}">

          <xacro:property
            name="arm1_initial_positions"
            value="${xacro.load_yaml('$(arg initial_positions_file)')}"
            />

          <xacro:ur_ros2_control
            name="$(arg arm1_prefix)$(arg arm_type)"
            tf_prefix="$(arg arm1_prefix)"
            initial_positions="${arm1_initial_positions}"
            />

        </xacro:if>
      </xacro:unless>

      <!-- Arm 2 ros2_control -->
      <xacro:unless value="${arm2 == ''}">
        <xacro:if value="${arm2 == 'ur5' or arm2 == 'ur10' or arm2 == 'ur5e' or arm2 == 'ur10e'}">

          <xacro:property
            name="arm2_initial_positions"
            value="${xacro.load_yaml('$(arg initial_positions_file)')}"
            />

          <xacro:ur_ros2_control
            name="$(arg arm2_prefix)$(arg arm2_type)"
            tf_prefix="$(arg arm2_prefix)"
            initial_positions="${arm2_initial_positions}"
            />

        </xacro:if>
      </xacro:unless>

    </xacro:unless>

  </xacro:if>

</robot>

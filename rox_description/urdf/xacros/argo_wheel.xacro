<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rox">

  <xacro:macro name="argo_wheel" params="name parent *origin joint_type">

   <joint name="${name}_joint" type="${joint_type}">
    <xacro:insert_block name="origin" />
    <limit effort="1000.0" lower="-1e+16" upper="1e+16" velocity="100"/>
    <dynamics damping="1.0" friction="1"/>
    <axis xyz="1 0 0" />
    <parent link="${parent}" />
    <child link="${name}_link" />
   </joint>

   <link name="${name}_link" type="wheel">
    <inertial>
    <!-- These are not accurate value -->
      <mass value="1.2" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.11042056" ixy="0.0" ixz="0.0" iyy="0.11042056" iyz="0.0" izz="0.11042056"/>
    </inertial>
    <xacro:if value="${linear_axis == True}">
      <visual>
        <origin rpy="0 0 ${pi}" xyz="0.289 0.229 -0.050" />
        <geometry>
          <mesh filename="package://rox_description/meshes/linear_axis_argo_wheel.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
    </xacro:if>
    <xacro:unless value="${linear_axis == True}">
      <visual>
        <origin rpy="0 0 ${pi}" xyz="0 0.0 0" />
        <geometry>
          <mesh filename="package://rox_description/meshes/argo_wheel.dae" scale="0.1 0.1 0.1"/>
        </geometry>
      </visual>
    </xacro:unless>
    <collision>
     <origin rpy="0 0 0" xyz="0 0.0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
   </link>

  </xacro:macro>

</robot>

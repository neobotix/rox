<?xml version="1.0"?>
<!--
Linear axis xacro for EMROX-Argo variant.
Reference: MPO-700 linear axis (neo_mpo_700-2)
Author: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rox">

  <xacro:macro name="linear_axis" params="parent">

    <!-- Linear-axis cabinet/dummy body -->
    <!-- All EMROX meshes share one CAD frame, so identity aligns naturally. -->
    <link name="cabinet_link">
      <inertial>
        <mass value="20.0" />
        <origin xyz="0 0 0.93" rpy="0 0 0"/>
        <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="2.0" iyz="0.0" izz="1.5"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/arm_dummy.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/arm_dummy.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="cabinet_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="cabinet_link"/>
    </joint>

    <!-- Linear axis base (rail/column) — fixed to platform -->
    <link name="linear_axis_fixed_link">
      <inertial>
        <mass value="15.0" />
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="0.5"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/linear_axis_base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/linear_axis_base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="linear_axis_fixed_joint" type="fixed">
      <!-- All EMROX meshes share the same CAD coordinate frame — identity transform -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="linear_axis_fixed_link"/>
    </joint>

    <!-- Linear axis carriage (slide) — moves up/down on rail -->
    <!--
      Slide mesh sits at Z=861-1161mm in CAD frame (mid-stroke position).
      At joint=0 (lowest), slide should be at Z≈335mm (just above rail base).
      Visual offset: -(861 - 335) = -526mm = -0.526m shifts mesh to bottom of travel.
    -->
    <link name="linear_axis_slide_link">
      <inertial>
        <mass value="8.0" />
        <origin xyz="0 0 -0.526" rpy="0 0 0"/>
        <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.3"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 -0.526"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/linear_axis_slide.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 -0.526"/>
        <geometry>
          <mesh filename="package://rox_description/meshes/linear_axis_slide.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="linear_axis_slide_joint" type="prismatic">
      <axis xyz="0 0 1"/>
      <!-- Shared CAD frame — identity transform -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Travel: 888mm derived from spec (1417mm column top - 529mm base top) -->
      <limit lower="0.0" upper="0.888" effort="54.0" velocity="0.15"/>
      <parent link="linear_axis_fixed_link"/>
      <child link="linear_axis_slide_link"/>
    </joint>

    <!-- ros2_control: REAL hardware -->
    <xacro:unless value="${gz == True}">
      <ros2_control name="linear_axis_control" type="system">
        <hardware>
          <plugin>nla/NlaHardwareInterface</plugin>
          <param name="can_iface">can1</param>
          <param name="timeout">0.2</param>
          <param name="control_rate">100.0</param>
          <param name="initial_pose">0.1</param>
        </hardware>
        <joint name="linear_axis_slide_joint">
          <command_interface name="velocity">
            <param name="min">0.0</param>
            <param name="max">0.2</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.1</param>
          </state_interface>
        </joint>
        <gpio name="linear_axis_gpio">
          <state_interface name="dig_in_1"/>
          <state_interface name="dig_in_2"/>
        </gpio>
      </ros2_control>
    </xacro:unless>

    <!-- ros2_control: SIMULATION (Gazebo) -->
    <xacro:if value="${gz == True}">
      <ros2_control name="linear_axis_control" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="linear_axis_slide_joint">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system">
          <parameters>$(arg simulation_controllers)</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
